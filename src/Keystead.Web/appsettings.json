{
  "//": "No secret of any kind belongs in this file. The master key is read from the environment or a mounted file; see MasterKeyOptions and DEPLOYMENT.md.",

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },

  "AllowedHosts": "*",

  "Keystead": {
    "Database": {
      "Path": "data/keystead.db",
      "BusyTimeoutMs": 5000,
      "IntegrityCheckOnStartup": true,
      "SqlCipherKey": null
    },

    "MasterKey": {
      "Source": "Environment",
      "EnvironmentVariable": "KEYSTEAD_MASTER_KEY",
      "PepperEnvironmentVariable": "KEYSTEAD_PASSWORD_PEPPER",
      "ActiveVersion": 1
    },

    "PasswordHashing": {
      "MemoryKib": 65536,
      "Iterations": 3,
      "Parallelism": 1,
      "SaltLength": 16,
      "HashLength": 32
    },

    "ReverseProxy": {
      "//": "Defaults trust only loopback. Add the proxy addresses here before putting Keystead behind one, or X-Forwarded-For can be spoofed by any client.",
      "KnownProxies": [],
      "KnownNetworks": []
    }
  }
}
