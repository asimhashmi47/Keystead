@page "/vaults/{slug}/secrets/{secretId:guid}"
@model Keystead.Web.Pages.SecretDetailModel
@inject Keystead.Web.Security.CspNonce Nonce
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = Model.Secret?.Name ?? "Secret";
    var tokens = Antiforgery.GetAndStoreTokens(HttpContext);
}

@if (Model.Vault is { } vault && Model.Secret is { } secret)
{
    <nav aria-label="Breadcrumb">
        <ol class="breadcrumbs">
            <li><a href="/vaults">Vaults</a></li>
            <li aria-hidden="true">/</li>
            <li><a href="/vaults/@vault.Slug">@vault.Name</a></li>
            <li aria-hidden="true">/</li>
            <li aria-current="page">@secret.Name</li>
        </ol>
    </nav>

    <div class="page-header">
        <div class="page-header__title">
            <h1>@secret.Name</h1>
            <span class="badge badge--neutral">@secret.Environment</span>

            @if (secret.SoftDeletedUtc is not null)
            {
                <span class="badge badge--danger">Deleted</span>
            }
            else if (!secret.Enabled)
            {
                <span class="badge badge--neutral">Disabled</span>
            }
            else if (secret.IsExpired(Model.Now))
            {
                <span class="badge badge--danger">Expired</span>
            }
        </div>
        <p class="page-header__description">
            Version @secret.LatestVersion of @secret.VersionCount.
            @if (secret.ExpiresUtc is { } expires)
            {
                <text>Expires @expires.ToString("d MMM yyyy").</text>
            }
        </p>
    </div>

    @if (Model.Notice is not null)
    {
        <div class="alert alert--success" role="status"><div>@Model.Notice</div></div>
    }

    @if (Model.Error is not null)
    {
        <div class="alert alert--danger" role="alert"><div>@Model.Error</div></div>
    }

    @*
        The value section. Nothing secret is in this markup: the placeholder is literal, and
        the value arrives only from a deliberate POST to the reveal handler.
    *@
    <div class="card" style="margin-bottom: var(--space-8);">
        <div class="card__header">
            <h2>Value</h2>
            <span class="field__hint" data-reveal-countdown></span>
        </div>
        <div class="card__body">
            <div class="secret-value">
                <code id="secret-value" data-reveal-output>••••••••••••••••••••••••</code>
            </div>

            <div style="display: flex; gap: var(--space-2); margin-top: var(--space-4);">
                <button class="btn btn--secondary btn--sm"
                        type="button"
                        data-reveal
                        data-reveal-url="@($"/vaults/{vault.Slug}/secrets/{secret.Id}?handler=Reveal")"
                        data-csrf="@tokens.RequestToken">
                    Reveal value
                </button>

                <button class="btn btn--ghost btn--sm"
                        type="button"
                        data-action="copy"
                        data-copy-target="secret-value"
                        hidden
                        data-reveal-copy>
                    Copy
                </button>
            </div>

            <p class="field__hint" style="margin-top: var(--space-3);" data-reveal-status role="status">
                Hidden. Revealing is recorded in the audit log, and needs your identity
                confirmed within the last few minutes.
            </p>
        </div>
    </div>

    <div class="card" style="margin-bottom: var(--space-8);">
        <div class="card__header">
            <h2>Version history</h2>
        </div>
        <div class="table-wrap">
            <table class="table">
                <caption class="visually-hidden">Versions of @secret.Name</caption>
                <thead>
                    <tr>
                        <th scope="col">Version</th>
                        <th scope="col">Written</th>
                        <th scope="col">By</th>
                        <th scope="col">Size</th>
                        <th scope="col">Key</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Versions)
                    {
                        <tr>
                            <td>
                                <strong>v@(item.Version)</strong>
                                @if (item.Version == secret.LatestVersion)
                                {
                                    <span class="badge badge--success">Current</span>
                                }
                            </td>
                            <td>
                                <time datetime="@item.CreatedUtc.ToString("O")">
                                    @item.CreatedUtc.ToString("d MMM yyyy, HH:mm")
                                </time>
                            </td>
                            <td>@item.CreatedByLabel</td>
                            <td>@item.SizeBytes bytes</td>
                            <td><span class="field__hint">KEK v@(item.KekVersion)</span></td>
                            <td style="text-align: right;">
                                @if (Model.CanWrite && item.Version != secret.LatestVersion
                                     && secret.SoftDeletedUtc is null)
                                {
                                    <form method="post" asp-page-handler="Rollback">
                                        <input type="hidden" name="targetVersion" value="@item.Version" />
                                        <button class="btn btn--ghost btn--sm" type="submit">
                                            Roll back to this
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card__footer">
            <span class="field__hint">
                Rolling back writes the old value as a new version rather than deleting
                history, so the rollback itself stays visible and can be undone.
            </span>
        </div>
    </div>

    @if (Model.CanWrite)
    {
        <div class="card" style="margin-bottom: var(--space-8);">
            <div class="card__header">
                <h2>Store a new value</h2>
            </div>
            <div class="card__body">
                @if (secret.SoftDeletedUtc is not null)
                {
                    <p class="field__hint">
                        This secret is deleted. Recover it before storing a new value.
                    </p>
                }
                else
                {
                    <form method="post" asp-page-handler="NewVersion" autocomplete="off">
                        <div class="field">
                            <label class="field__label" for="new-value">New value</label>
                            <textarea class="textarea input--mono" id="new-value" rows="3"
                                      required autocomplete="off" spellcheck="false"
                                      asp-for="Input.Value"></textarea>
                            <p class="field__hint">
                                Appended as version @(secret.LatestVersion + 1). The current
                                value is kept and stays readable.
                            </p>
                        </div>
                        <button class="btn btn--primary" type="submit">Store new version</button>
                    </form>
                }
            </div>
        </div>

        <div class="card">
            <div class="card__header">
                <h2>Manage</h2>
            </div>
            <div class="card__body" style="display: flex; gap: var(--space-3); flex-wrap: wrap;">
                @if (secret.SoftDeletedUtc is not null)
                {
                    <form method="post" asp-page-handler="Recover">
                        <button class="btn btn--secondary" type="submit">Recover secret</button>
                    </form>
                }
                else
                {
                    <form method="post" asp-page-handler="SetEnabled">
                        <input type="hidden" name="enabled" value="@(!secret.Enabled)" />
                        <button class="btn btn--secondary" type="submit">
                            @(secret.Enabled ? "Disable" : "Enable")
                        </button>
                    </form>

                    <form method="post" asp-page-handler="Delete">
                        <button class="btn btn--danger" type="submit">Delete secret</button>
                    </form>
                }
            </div>
            <div class="card__footer">
                <span class="field__hint">
                    Disabling stops the secret resolving but keeps every version. Deleting is
                    reversible for this vault's recovery window.
                </span>
            </div>
        </div>
    }
}

@section Scripts {
    <script nonce="@Nonce.Value" src="~/js/reveal.js" type="module"></script>
}
