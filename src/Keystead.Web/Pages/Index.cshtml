@page
@model Keystead.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-header">
    <div class="page-header__title">
        <h1>@(Model.Workspace?.Name ?? "Dashboard")</h1>
        @if (Model.Workspace is { } workspace)
        {
            <span class="badge badge--neutral">@workspace.Role</span>
        }
    </div>
    <p class="page-header__description">
        What this workspace holds, and what needs attention.
    </p>
</div>

<div class="grid grid--metrics" style="margin-bottom: var(--space-8);">
    <div class="metric">
        <p class="metric__label">Secrets</p>
        <p class="metric__value">@Model.SecretCount</p>
        <p class="metric__hint">
            across @Model.VaultCount vault@(Model.VaultCount == 1 ? "" : "s") you can reach
        </p>
    </div>

    <div class="metric">
        <p class="metric__label">Expiring soon</p>
        <p class="metric__value">@Model.ExpiringSoonCount</p>
        <p class="metric__hint">within the next 30 days</p>
    </div>

    <div class="metric">
        <p class="metric__label">Already expired</p>
        <p class="metric__value">@Model.ExpiredCount</p>
        <p class="metric__hint">
            @(Model.ExpiredCount == 0 ? "Nothing overdue" : "Rotate these")
        </p>
    </div>

    <div class="metric">
        <p class="metric__label">Vaults</p>
        <p class="metric__value">@Model.VaultCount</p>
        <p class="metric__hint">
            <a href="/vaults">Manage vaults</a>
        </p>
    </div>
</div>

@if (Model.NeedsAttention.Count > 0)
{
    <div class="card" style="margin-bottom: var(--space-8);">
        <div class="card__header">
            <h2>Needs attention</h2>
        </div>
        <div class="table-wrap">
            <table class="table">
                <caption class="visually-hidden">Secrets that have expired or expire soon</caption>
                <thead>
                    <tr>
                        <th scope="col">Secret</th>
                        <th scope="col">Vault</th>
                        <th scope="col">Environment</th>
                        <th scope="col">Expires</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.NeedsAttention)
                    {
                        <tr>
                            <td>
                                <a href="/vaults/@item.VaultSlug/secrets/@item.Secret.Id">
                                    <strong>@item.Secret.Name</strong>
                                </a>
                            </td>
                            <td><a href="/vaults/@item.VaultSlug">@item.VaultName</a></td>
                            <td><span class="badge badge--neutral">@item.Secret.Environment</span></td>
                            <td>
                                @if (item.Secret.ExpiresUtc is { } expires)
                                {
                                    <time datetime="@expires.ToString("O")">
                                        @expires.ToString("d MMM yyyy")
                                    </time>

                                    @if (expires <= DateTimeOffset.UtcNow)
                                    {
                                        <span class="badge badge--danger">Expired</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge--warning">Soon</span>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="card">
    <div class="card__header">
        <h2>Vaults</h2>
        <a class="btn btn--secondary btn--sm" href="/vaults">All vaults</a>
    </div>

    @if (Model.Vaults.Count == 0)
    {
        <div class="empty">
            <div class="empty__art" aria-hidden="true">
                <svg width="56" height="56" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="8" y="14" width="48" height="38" rx="5" />
                    <circle cx="32" cy="33" r="8" />
                </svg>
            </div>
            <p class="empty__title">Nothing here yet</p>
            <p class="empty__body">
                Create a vault to start storing secrets, or ask an administrator for access to
                an existing one.
            </p>
            <a class="btn btn--primary" href="/vaults">Go to vaults</a>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="table">
                <caption class="visually-hidden">Vaults you can reach</caption>
                <thead>
                    <tr>
                        <th scope="col">Vault</th>
                        <th scope="col">Secrets</th>
                        <th scope="col">Expiring soon</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var vault in Model.Vaults)
                    {
                        <tr>
                            <td>
                                <span class="badge badge--neutral"
                                      style="color: var(--badge-@vault.ColorToken);">
                                    <span class="badge__dot" aria-hidden="true"></span>
                                </span>
                                <a href="/vaults/@vault.Slug">@vault.Name</a>
                            </td>
                            <td>@vault.SecretCount</td>
                            <td>
                                @if (vault.ExpiringSoonCount > 0)
                                {
                                    <span class="badge badge--warning">@vault.ExpiringSoonCount</span>
                                }
                                else
                                {
                                    <span class="field__hint">None</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
