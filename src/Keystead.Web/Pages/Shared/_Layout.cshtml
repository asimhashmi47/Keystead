@*
    The authenticated application shell.

    Every authenticated page renders inside this layout, so the sidebar is always present
    (CLAUDE.md UI rules). The sign-in and setup pages use _LayoutPublic instead.

    There is no inline script and no inline event handler anywhere in this file. Behaviour
    comes from external modules in wwwroot/js, each carrying this request's CSP nonce.
*@
@inject Keystead.Web.Security.CspNonce Nonce
@inject Keystead.Application.Workspaces.ICurrentWorkspace Workspaces
@{
    // Resolved here rather than in every page model, so the shell can show which workspace
    // the person is acting in without each page having to pass it up.
    var currentUserId = Keystead.Web.Security.KeysteadClaims.GetUserId(User);

    var memberships = currentUserId is { } uid
        ? await Workspaces.ListForUserAsync(uid, Context.RequestAborted)
        : [];

    // Resolved through the same path the pages use, so the shell shows the workspace the
    // person actually switched to rather than always their first one.
    Guid? requestedWorkspace = null;

    if (Context.Request.Cookies.TryGetValue("__Host-keystead-ws", out var wsCookie)
        && Guid.TryParse(wsCookie, System.Globalization.CultureInfo.InvariantCulture, out var wsParsed))
    {
        requestedWorkspace = wsParsed;
    }

    var currentWorkspace = currentUserId is { } resolveFor
        ? await Workspaces.ResolveAsync(resolveFor, requestedWorkspace, Context.RequestAborted)
        : null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <title>@ViewData["Title"] &middot; Keystead</title>
    <link rel="stylesheet" href="~/css/keystead.css" />
    <link rel="icon" href="~/favicon.ico" />
</head>
<body>
    <a class="skip-link" href="#main">Skip to main content</a>

    <div class="app">
        <aside class="sidebar" id="sidebar" data-open="false">
            <a class="sidebar__brand" href="/">
                <span class="sidebar__mark" aria-hidden="true">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="10" rx="2" />
                        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                    </svg>
                </span>
                Keystead
            </a>

            @if (currentWorkspace is { } workspace)
            {
                <div class="sidebar__workspace">
                    <p class="sidebar__workspace-label">Workspace</p>
                    <p class="sidebar__workspace-name">@workspace.Name</p>

                    @if (memberships.Count > 1)
                    {
                        @* Shown only when there is something to switch to, so a single-workspace
                           installation is not given a control that does nothing. *@
                        <form class="u-mt-2" method="post" action="/workspace/switch">
                            <label class="visually-hidden" for="workspace-switch">
                                Switch workspace
                            </label>
                            <select class="select" id="workspace-switch" name="workspaceId">
                                @foreach (var option in memberships)
                                {
                                    <option value="@option.WorkspaceId"
                                            selected="@(option.WorkspaceId == workspace.WorkspaceId)">
                                        @option.Name
                                    </option>
                                }
                            </select>
                            <button class="btn btn--secondary btn--sm u-mt-2 u-block" type="submit">
                                Switch
                            </button>
                        </form>
                    }
                </div>
            }

            <nav class="sidebar__section" aria-label="Main">
                <p class="sidebar__label">Overview</p>
                <ul class="sidebar__nav">
                    <li>
                        <a class="sidebar__link" href="/" aria-current="@Current("/Index")">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <rect x="3" y="3" width="7" height="9" rx="1.5" />
                                <rect x="14" y="3" width="7" height="5" rx="1.5" />
                                <rect x="14" y="12" width="7" height="9" rx="1.5" />
                                <rect x="3" y="16" width="7" height="5" rx="1.5" />
                            </svg>
                            Dashboard
                        </a>
                    </li>
                    <li>
                        <a class="sidebar__link" href="/vaults" aria-current="@Current("/Vaults/Index")">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <rect x="3" y="4" width="18" height="16" rx="2.5" />
                                <circle cx="12" cy="12" r="3.2" />
                                <path d="M12 8.8V6.2M12 17.8v-2.6M15.2 12h2.6M6.2 12h2.6" />
                            </svg>
                            Vaults
                        </a>
                    </li>
                    <li>
                        <a class="sidebar__link" href="/audit" aria-current="@Current("/Audit/Index")">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M5 3h9l5 5v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z" />
                                <path d="M14 3v5h5M8 13h8M8 17h5" />
                            </svg>
                            Audit log
                        </a>
                    </li>
                </ul>
            </nav>

            <nav class="sidebar__section" aria-label="Administration">
                <p class="sidebar__label">Administration</p>
                <ul class="sidebar__nav">
                    <li>
                        <a class="sidebar__link" href="/members" aria-current="@Current("/Members/Index")">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="9" cy="8" r="3.4" />
                                <path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6" />
                                <path d="M16 11.2A3.4 3.4 0 0 0 16 4.6M18 19.4c0-2-.8-3.9-2.2-5.2" />
                            </svg>
                            Members
                        </a>
                    </li>
                    <li>
                        <a class="sidebar__link" href="/identities" aria-current="@Current("/Identities/Index")">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <rect x="3" y="5" width="18" height="14" rx="2.5" />
                                <path d="M3 10h18M7.5 14.5h3" />
                            </svg>
                            Service identities
                        </a>
                    </li>
                    <li>
                        <a class="sidebar__link" href="/security" aria-current="@Current("/Security/Index")">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M12 3l7.5 3v5.6c0 4.4-3 8.2-7.5 9.4-4.5-1.2-7.5-5-7.5-9.4V6z" />
                                <path d="M9.2 12.2l2 2 3.6-3.8" />
                            </svg>
                            Security centre
                        </a>
                    </li>
                </ul>
            </nav>

        </aside>

        <div class="main">
            <header class="topbar">
                <button class="btn btn--ghost btn--sm topbar__menu-toggle"
                        type="button"
                        data-action="toggle-sidebar"
                        aria-controls="sidebar"
                        aria-expanded="false">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                        <path d="M4 7h16M4 12h16M4 17h16" />
                    </svg>
                    <span class="visually-hidden">Toggle navigation</span>
                </button>

                <form class="topbar__search" method="get" action="/search" role="search">
                    <label class="visually-hidden" for="global-search">Search secrets and vaults</label>

                    <svg class="topbar__search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                        <circle cx="11" cy="11" r="7" />
                        <path d="m20 20-3.6-3.6" />
                    </svg>

                    <input class="input topbar__search-input"
                           id="global-search"
                           name="q"
                           type="search"
                           placeholder="Search secrets and vaults"
                           autocomplete="off" />

                    @* The shortcut sits inside the field because that is where it is read:
                       it describes the field, not a separate control beside it. It is still a
                       real button, so the palette is reachable by pointer as well as by key. *@
                    <button class="topbar__shortcut" type="button" data-action="open-palette">
                        <kbd>Ctrl</kbd><kbd>K</kbd>
                        <span class="visually-hidden">Open the command palette</span>
                    </button>
                </form>

                @if (currentWorkspace is { } current)
                {
                    <div class="topbar__account">
                        <a class="account" href="/profile" aria-current="@Current("/Profile/Index")">
                            <span class="account__avatar" aria-hidden="true">@Initials(User.Identity?.Name)</span>
                            <span class="account__text">
                                <span class="account__name">@(User.Identity?.Name ?? "Account")</span>
                                <span class="account__role">@current.Role</span>
                            </span>
                        </a>

                        @* A link to the confirmation page rather than a form that signs out
                           on click. Signing out is cheap to undo but annoying to do by
                           accident, and the page is also what makes the action a POST with a
                           token rather than something a cross-site image request could
                           trigger. *@
                        <a class="btn btn--ghost btn--sm btn--icon" href="/sign-out" title="Sign out">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M15 17v2a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7a2 2 0 0 1 2 2v2" />
                                <path d="M19 12H9m10 0-3-3m3 3-3 3" />
                            </svg>
                            <span class="visually-hidden">Sign out</span>
                        </a>
                    </div>
                }

            </header>

            <main class="content" id="main">
                @RenderBody()
            </main>
        </div>
    </div>

    @*
        The command palette. Rendered as a <dialog> so focus trapping, Escape and the
        backdrop come from the platform rather than from a hand-rolled modal.
    *@
    <dialog class="palette" id="palette" aria-label="Command palette">
        <div class="palette__field">
            <label class="visually-hidden" for="palette-input">
                Search vault and secret names
            </label>
            <input class="palette__input"
                   id="palette-input"
                   type="search"
                   placeholder="Search vault and secret names"
                   autocomplete="off"
                   role="combobox"
                   aria-expanded="true"
                   aria-controls="palette-results"
                   data-palette-input />
        </div>

        <div class="palette__results"
             id="palette-results"
             role="listbox"
             aria-label="Results"
             data-palette-results></div>

        <p class="palette__footer" role="status" aria-live="polite" data-palette-status>
            Type to search vault and secret names.
        </p>
    </dialog>

    <script nonce="@Nonce.Value" src="~/js/shell.js" type="module"></script>
    <script nonce="@Nonce.Value" src="~/js/palette.js" type="module"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@functions {
    // Returns the ARIA current value for a nav link, so the active page is announced to a
    // screen reader as well as being visually highlighted.
    private string? Current(string page) =>
        string.Equals(ViewContext.ActionDescriptor.DisplayName, page, System.StringComparison.OrdinalIgnoreCase)
        || string.Equals((string?)ViewContext.RouteData.Values["page"], page, System.StringComparison.OrdinalIgnoreCase)
            ? "page"
            : null;

    // The monogram on the account control. The principal carries the sign-in address rather
    // than a display name, so this takes the local part and splits it on the separators people
    // actually use in one: "ada.lovelace@..." gives AL, "ada@..." gives A.
    //
    // It is a monogram and nothing turns on it, which is why a convention is good enough here
    // and would not be anywhere a name is asserted rather than decorated.
    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "?";
        }

        var local = name.Split('@', 2)[0];
        var parts = local.Split([' ', '.', '_', '-', '+'], System.StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length == 0)
        {
            return "?";
        }

        return parts.Length >= 2
            ? string.Concat(char.ToUpperInvariant(parts[0][0]), char.ToUpperInvariant(parts[1][0]))
            : char.ToUpperInvariant(parts[0][0]).ToString();
    }
}
