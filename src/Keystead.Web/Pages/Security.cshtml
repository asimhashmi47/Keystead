@page "/security"
@model Keystead.Web.Pages.SecurityModel
@{
    ViewData["Title"] = "Security centre";
}

<div class="page-header">
    <div class="page-header__title">
        <h1>Security centre</h1>
    </div>
    <p class="page-header__description">
        Your second factor, and everywhere you are currently signed in.
    </p>
</div>

<div class="grid grid--metrics u-section">
    <div class="metric">
        <p class="metric__label">Two-factor authentication</p>
        <p class="metric__value u-text-xl">
            @if (Model.MfaEnabled)
            {
                <span class="badge badge--success">
                    <span class="badge__dot" aria-hidden="true"></span> Enrolled
                </span>
            }
            else
            {
                <span class="badge badge--warning">
                    <span class="badge__dot" aria-hidden="true"></span> Not enrolled
                </span>
            }
        </p>
        @if (!Model.MfaEnabled)
        {
            <p class="metric__hint">
                <a href="/mfa/enrol">Set up an authenticator</a>
            </p>
        }
    </div>

    <div class="metric">
        <p class="metric__label">Recovery codes remaining</p>
        <p class="metric__value">@Model.RecoveryCodesRemaining</p>
        <p class="metric__hint">
            @if (Model.RecoveryCodesRemaining == 0 && Model.MfaEnabled)
            {
                <text>None left. Re-enrol to get a new set.</text>
            }
            else
            {
                <text>Each one works a single time.</text>
            }
        </p>
    </div>

    <div class="metric">
        <p class="metric__label">Active sessions</p>
        <p class="metric__value">@Model.Sessions.Count</p>
        <p class="metric__hint">Across all your devices</p>
    </div>
</div>

<div class="card">
    <div class="card__header">
        <h2>Active sessions</h2>

        @if (Model.Sessions.Count > 1)
        {
            <form method="post" asp-page-handler="RevokeAll">
                <button class="btn btn--danger btn--sm" type="submit">
                    Sign out everywhere else
                </button>
            </form>
        }
    </div>

    @if (Model.Sessions.Count == 0)
    {
        <div class="empty">
            <p class="empty__title">No other sessions</p>
            <p class="empty__body">You are only signed in here.</p>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="table">
                <caption class="visually-hidden">Your active sessions</caption>
                <thead>
                    <tr>
                        <th scope="col">Signed in</th>
                        <th scope="col">Last active</th>
                        <th scope="col">Address</th>
                        <th scope="col">Device</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var session in Model.Sessions)
                    {
                        <tr>
                            <td>
                                <time datetime="@session.CreatedUtc.ToString("O")">
                                    @session.CreatedUtc.ToString("d MMM yyyy, HH:mm")
                                </time>
                                @if (session.IsCurrent)
                                {
                                    <span class="badge badge--info u-ml-2">
                                        This device
                                    </span>
                                }
                            </td>
                            <td>
                                <time datetime="@session.LastSeenUtc.ToString("O")">
                                    @session.LastSeenUtc.ToString("HH:mm")
                                </time>
                            </td>
                            <td><code>@session.CreatedIp</code></td>
                            <td>@session.UserAgent</td>
                            <td class="u-end">
                                @if (!session.IsCurrent)
                                {
                                    <form method="post" asp-page-handler="Revoke">
                                        <input type="hidden" name="sessionId" value="@session.Id" />
                                        <button class="btn btn--ghost btn--sm" type="submit">
                                            Revoke
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
