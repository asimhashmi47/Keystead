root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,md,csproj,props,targets,slnx}]
indent_size = 2

[*.{cshtml,html,css,js}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.cs]
indent_size = 4
csharp_using_directive_placement = outside_namespace:error
csharp_style_namespace_declarations = file_scoped:error
csharp_prefer_braces = true:warning
csharp_style_var_elsewhere = false:suggestion
csharp_style_prefer_primary_constructors = true:suggestion
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
# "always" would demand 'public' on interface members, where the modifier is implicit and
# convention omits it. Non-interface members must still be explicit.
dotnet_style_require_accessibility_modifiers = for_non_interface_members:error
dotnet_style_readonly_field = true:warning
dotnet_diagnostic.IDE0005.severity = error

# ---------------------------------------------------------------------------
# Security analyzers. These are the rules that protect the product's core
# promises, so they are errors, not suggestions.
# ---------------------------------------------------------------------------
dotnet_diagnostic.CA2100.severity = error   # SQL built from string input
dotnet_diagnostic.CA3001.severity = error   # SQL injection
dotnet_diagnostic.CA3002.severity = error   # XSS from untrusted input
dotnet_diagnostic.CA3003.severity = error   # file path injection
dotnet_diagnostic.CA3004.severity = error   # information disclosure
dotnet_diagnostic.CA3006.severity = error   # process command injection
dotnet_diagnostic.CA3007.severity = error   # open redirect
dotnet_diagnostic.CA3012.severity = error   # regex injection
dotnet_diagnostic.CA3075.severity = error   # insecure DTD processing
dotnet_diagnostic.CA3077.severity = error   # insecure XML processing
dotnet_diagnostic.CA5350.severity = error   # weak crypto (SHA1, TripleDES)
dotnet_diagnostic.CA5351.severity = error   # broken crypto (MD5, DES, RC2)
dotnet_diagnostic.CA5358.severity = error   # unsafe cipher modes (ECB, CBC-no-MAC)
dotnet_diagnostic.CA5359.severity = error   # certificate validation disabled
dotnet_diagnostic.CA5360.severity = error   # dangerous deserialization
dotnet_diagnostic.CA5364.severity = error   # deprecated security protocols
dotnet_diagnostic.CA5365.severity = error   # HTTP header checking disabled
dotnet_diagnostic.CA5386.severity = error   # hardcoded SecurityProtocolType
dotnet_diagnostic.CA5389.severity = error   # archive path traversal
dotnet_diagnostic.CA5390.severity = error   # hardcoded encryption key
dotnet_diagnostic.CA5391.severity = error   # antiforgery token missing
dotnet_diagnostic.CA5392.severity = error   # DefaultDllImportSearchPaths
dotnet_diagnostic.CA5394.severity = error   # insecure randomness
dotnet_diagnostic.CA5395.severity = error   # missing HttpVerb attribute
dotnet_diagnostic.CA5397.severity = error   # deprecated SslProtocols
dotnet_diagnostic.CA5399.severity = error   # HttpClient certificate revocation
dotnet_diagnostic.CA5400.severity = error   # HttpClient revocation list
dotnet_diagnostic.CA5401.severity = error   # CreateEncryptor with non-default IV
dotnet_diagnostic.CA5402.severity = error   # CreateEncryptor default IV
dotnet_diagnostic.CA5403.severity = error   # do not hardcode certificate

# Correctness rules that matter for this codebase
dotnet_diagnostic.CA2016.severity = error   # forward CancellationToken
dotnet_diagnostic.CA1062.severity = error   # validate public arguments
dotnet_diagnostic.CA2000.severity = error   # dispose before losing scope

# ---------------------------------------------------------------------------
# Deliberately relaxed, with reasons.
# ---------------------------------------------------------------------------
# CA1812: DI-instantiated internal types look uninstantiated to the analyzer.
dotnet_diagnostic.CA1812.severity = none
# CA1711: "Permission" and "Flags" are reserved suffixes for library surface. VaultPermission
# is the domain's own word for the thing, and renaming it to VaultAccessLevel would make the
# code read worse than the specification it implements.
dotnet_diagnostic.CA1711.severity = none
# CA1000: Result<T>.Ok / Result<T>.Fail are the conventional factories for a result type.
# The alternative (a non-generic companion class) adds a type to save nothing.
dotnet_diagnostic.CA1000.severity = none
# CA1848: LoggerMessage source-gen delegates are not worth the noise at this size.
dotnet_diagnostic.CA1848.severity = none
# CA1727: we use lowercase structured-log property names consistently.
dotnet_diagnostic.CA1727.severity = none
# MA0004/CA2007: ConfigureAwait is irrelevant in ASP.NET Core (no sync context).
dotnet_diagnostic.CA2007.severity = none

# ---------------------------------------------------------------------------
# EF Core migrations are generated by `dotnet ef`, not written by hand. Holding
# them to the hand-written style and API-design rules would mean editing machine
# output after every scaffold, and the edits would be lost on the next one.
#
# Correctness is still enforced where it matters: the migration is exercised by
# applying it in the integration test suite, which is a stronger check than any
# analyzer rule about null-checking a parameter the framework always supplies.
# ---------------------------------------------------------------------------
[**/Persistence/Migrations/*.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none
dotnet_diagnostic.CA1062.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.IDE0005.severity = none
dotnet_diagnostic.IDE0040.severity = none

[tests/**/*.cs]
# Test names use underscores to state behaviour: Decrypt_WithTamperedTag_Throws.
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA5394.severity = none
